# Optional: JOBHUNT_API_KEY= (auto-generated local pairing key when unset)
JOBHUNT_DB=./jobhunt.db
JOBHUNT_SCAN_MINUTES=15
JOBHUNT_INITIAL_DAYS=30
JOBHUNT_ALERT_SCORE=85
JOBHUNT_OPENCODE_URL=http://127.0.0.1:4096
JOBHUNT_OPENCODE_MODEL=
JOBHUNT_OPENCODE_PASSWORD=
JOBHUNT_FCM_PROJECT=
JOBHUNT_FCM_TOKEN_FILE=
JOBHUNT_COMPANY_FEEDS=
# Optional: pin an existing OpenCode free model; otherwise discover /provider
# JOBHUNT_OPENCODE_MODEL=opencode/your-current-free-model
# Optional: JOBHUNT_KEY_FILE=.jobhunt-api-key
# Automatically run local OpenCode server when installed: 1=yes / 0=no
JOBHUNT_AUTOSTART_OPENCODE=1
# JOBHUNT_PORT=8765
